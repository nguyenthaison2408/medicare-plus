{
  "expo": {
    "name": "Medicare Plus",
    "slug": "medicare-plus",
    "scheme": "medicareplus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.medicareplus.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép Medicare Plus sử dụng máy ảnh để quét mã QR và chụp ảnh đại diện.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép Medicare Plus truy cập thư viện ảnh để cập nhật ảnh đại diện.",
          "cameraPermission": "Cho phép Medicare Plus sử dụng máy ảnh để chụp ảnh đại diện."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "838e3f57-18d2-4132-b1fc-39531145f58f"
      }
    },
    "owner": "thanhvuvn"
  }
}
