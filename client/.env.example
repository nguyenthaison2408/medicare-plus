# Keep demo until the Supabase migration has been applied and cloud verification passes.
EXPO_PUBLIC_DATA_MODE=demo
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Only public/publishable keys belong in an Expo app. Never put a service-role key here.

# Optional: Google Apps Script Webhook or EmailJS config for sending booking confirmation emails
EXPO_PUBLIC_BOOKING_EMAIL_WEBHOOK_URL=
EXPO_PUBLIC_EMAILJS_SERVICE_ID=
EXPO_PUBLIC_EMAILJS_TEMPLATE_ID=
EXPO_PUBLIC_EMAILJS_PUBLIC_KEY=

# Webhook POST must respond with JSON {"ok":true} only after sending succeeds.
# Return {"ok":false,"error":"reason"} on failure; an HTML/empty 200 is not success.
